{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/KiYouJyo/ReferenceCity/main/schemas/v0.1/event.schema.json",
  "title": "ReferenceCity Event v0.1",
  "type": "object",
  "required": ["event_id", "event_type", "actor_id", "target_id", "occurred_at", "recorded_at", "authorized", "accepted", "state_changed", "payload_hash"],
  "properties": {
    "event_id": { "$ref": "common.schema.json#/$defs/stableId" },
    "event_type": {
      "enum": ["CREATE", "SUBMIT", "REVIEW", "APPROVE", "REJECT", "ACTIVATE", "AMEND", "WITHDRAW", "SUPERSEDE", "ATTEMPT_UNAUTHORIZED_CHANGE", "VERIFY"]
    },
    "actor_id": { "$ref": "common.schema.json#/$defs/stableId" },
    "target_id": { "$ref": "common.schema.json#/$defs/stableId" },
    "occurred_at": { "$ref": "common.schema.json#/$defs/isoDateTime" },
    "recorded_at": { "$ref": "common.schema.json#/$defs/isoDateTime" },
    "previous_version": { "type": ["integer", "null"], "minimum": 1 },
    "resulting_version": { "type": ["integer", "null"], "minimum": 1 },
    "authorized": { "type": "boolean" },
    "accepted": { "type": "boolean" },
    "state_changed": { "type": "boolean" },
    "authority_basis": { "type": ["string", "null"] },
    "related_document_ids": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/stableId" }, "uniqueItems": true },
    "payload": { "type": "object" },
    "payload_hash": { "$ref": "common.schema.json#/$defs/contentHash" }
  },
  "additionalProperties": false
}
