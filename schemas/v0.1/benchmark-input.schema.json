{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/KiYouJyo/ReferenceCity/main/schemas/v0.1/benchmark-input.schema.json",
  "title": "ReferenceCity Benchmark Input Bundle Manifest v0.1",
  "type": "object",
  "required": ["benchmark_id", "benchmark_version", "protocol_version", "ground_truth_included", "core_snapshot_ref", "scenario_count", "scenarios"],
  "properties": {
    "benchmark_id": { "$ref": "common.schema.json#/$defs/stableId" },
    "benchmark_version": { "const": "0.1.0" },
    "protocol_version": { "const": "0.1" },
    "ground_truth_included": { "const": false },
    "core_snapshot_ref": { "type": "string", "minLength": 1 },
    "scenario_count": { "const": 10 },
    "scenarios": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["scenario_id", "scenario_ref", "request_refs", "fixture_refs"],
        "properties": {
          "scenario_id": { "$ref": "common.schema.json#/$defs/stableId" },
          "scenario_ref": { "type": "string", "minLength": 1 },
          "request_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "fixture_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
