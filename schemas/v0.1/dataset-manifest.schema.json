{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/KiYouJyo/ReferenceCity/main/schemas/v0.1/dataset-manifest.schema.json",
  "title": "ReferenceCity Dataset Manifest v0.1",
  "type": "object",
  "required": ["dataset_id", "title", "dataset_version", "generated_at", "crs", "units", "assets"],
  "properties": {
    "dataset_id": { "$ref": "common.schema.json#/$defs/stableId" },
    "title": { "$ref": "common.schema.json#/$defs/localizedText" },
    "dataset_version": { "type": "string", "pattern": "^0\\.[0-9]+\\.[0-9]+$" },
    "generated_at": { "$ref": "common.schema.json#/$defs/isoDateTime" },
    "random_seed": { "type": "integer" },
    "crs": {
      "type": "object",
      "required": ["kind", "identifier"],
      "properties": {
        "kind": { "enum": ["SYNTHETIC_CARTESIAN", "EPSG"] },
        "identifier": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "units": {
      "type": "object",
      "required": ["length", "area", "ratio"],
      "properties": {
        "length": { "const": "m" },
        "area": { "const": "m2" },
        "ratio": { "const": "decimal" }
      },
      "additionalProperties": false
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "source_type", "sensitivity"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "hash": { "$ref": "common.schema.json#/$defs/contentHash" },
          "source_type": { "$ref": "common.schema.json#/$defs/sourceType" },
          "sensitivity": { "$ref": "common.schema.json#/$defs/sensitivity" },
          "source_ref": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
