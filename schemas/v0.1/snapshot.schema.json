{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/KiYouJyo/ReferenceCity/main/schemas/v0.1/snapshot.schema.json",
  "title": "ReferenceCity Core Snapshot Descriptor v0.1",
  "type": "object",
  "required": ["snapshot_id", "dataset_version", "schema_version", "generator", "config", "counts", "assets"],
  "properties": {
    "snapshot_id": { "$ref": "common.schema.json#/$defs/stableId" },
    "dataset_version": { "type": "string", "pattern": "^0\\.[0-9]+\\.[0-9]+$" },
    "schema_version": { "type": "string", "pattern": "^0\\.[0-9]+$" },
    "generator": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "common.schema.json#/$defs/contentHash" }
      },
      "additionalProperties": false
    },
    "config": {
      "type": "object",
      "required": ["path", "sha256", "random_seed"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "common.schema.json#/$defs/contentHash" },
        "random_seed": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "required": ["spatial_objects", "planning_objects"],
      "properties": {
        "spatial_objects": { "type": "integer", "minimum": 0 },
        "planning_objects": { "type": "integer", "minimum": 0 },
        "by_spatial_type": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      },
      "additionalProperties": false
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "file_sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "file_sha256": { "$ref": "common.schema.json#/$defs/contentHash" },
          "canonical_sha256": { "$ref": "common.schema.json#/$defs/contentHash" },
          "media_type": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
