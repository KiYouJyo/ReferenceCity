{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/KiYouJyo/ReferenceCity/main/schemas/v0.1/spatial-object.schema.json",
  "title": "ReferenceCity Spatial Object v0.1",
  "type": "object",
  "required": ["id", "object_type", "geometry", "version", "valid_from", "provenance"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/stableId" },
    "object_type": {
      "enum": ["city", "district", "subdistrict_or_town", "planning_unit", "parcel", "building", "road_segment", "waterbody", "facility"]
    },
    "name": { "$ref": "common.schema.json#/$defs/localizedText" },
    "parent_id": {
      "anyOf": [
        { "$ref": "common.schema.json#/$defs/stableId" },
        { "type": "null" }
      ]
    },
    "geometry": { "$ref": "common.schema.json#/$defs/geojsonGeometry" },
    "version": { "$ref": "common.schema.json#/$defs/objectVersion" },
    "valid_from": { "$ref": "common.schema.json#/$defs/isoDateTime" },
    "valid_to": { "$ref": "common.schema.json#/$defs/nullableDateTime" },
    "area_m2": { "type": "number", "minimum": 0 },
    "length_m": { "type": "number", "minimum": 0 },
    "properties": { "type": "object" },
    "provenance": { "$ref": "common.schema.json#/$defs/provenance" }
  },
  "additionalProperties": false
}
